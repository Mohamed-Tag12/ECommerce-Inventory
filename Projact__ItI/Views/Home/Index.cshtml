@using Microsoft.AspNetCore.Http
@using Projact__ItI.ViewModels

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/AdminLayout.cshtml";

    var userName = Context.Session.GetString("UserName") ?? "Admin";

    decimal totalRevenue = ViewBag.TotalRevenue;
    decimal todayRevenue = ViewBag.TodayRevenue;
    decimal totalValue = ViewBag.TotalValue;
    int salesCount = ViewBag.SalesCount;
    int itemsSold = ViewBag.ItemsSold;
    int totalProducts = ViewBag.TotalProducts;
    int totalCategories = ViewBag.TotalCategories;
    int totalStock = ViewBag.TotalStock;

    var recentSales = (List<Sale>)ViewBag.RecentSales;
    var topProducts = (List<TopProductViewModel>)ViewBag.TopProducts;
    var lowStock = (List<Product>)ViewBag.LowStockProducts;
    var lastProducts = (List<Product>)ViewBag.LastProducts;

    int totalCustomers = ViewBag.TotalCustomers;
    int totalSuppliers = ViewBag.TotalSuppliers;
    decimal expenses30 = ViewBag.Expenses30;
    decimal cashFlow30 = ViewBag.CashFlow30;
}

<div class="container-fluid">

    <!-- ============ Hero ============ -->
    <div class="hero mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div style="position:relative;z-index:1">
                <h2>Welcome back, @userName 👋</h2>
                <p>Here is what is happening in your store today.</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Sale" asp-action="Add" class="btn">
                        <i class="bi bi-cart-plus me-2"></i>New Sale
                    </a>
                    <a asp-controller="Product" asp-action="Add" class="btn ghost">
                        <i class="bi bi-plus-circle me-2"></i>Add Product
                    </a>
                    <a asp-controller="Report" asp-action="Index" class="btn ghost">
                        <i class="bi bi-bar-chart-line me-2"></i>Reports
                    </a>
                </div>
            </div>
            <div class="today">
                <small>Today's sales</small>
                <strong>@todayRevenue.ToString("N0") EGP</strong>
            </div>
        </div>
    </div>

    <!-- ============ Stat cards ============ -->
    <div class="row g-4">

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="card-icon" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="bi bi-cash-coin"></i></div>
                <div>
                    <h6>Total Revenue</h6>
                    <h3>@totalRevenue.ToString("N0") <small>EGP</small></h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="card-icon" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-receipt"></i></div>
                <div>
                    <h6>Orders</h6>
                    <h3>@salesCount</h3>
                    <small>@itemsSold items sold</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="card-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-box-seam"></i></div>
                <div>
                    <h6>Products</h6>
                    <h3>@totalProducts</h3>
                    <small>in @totalCategories categories</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="card-icon" style="background:linear-gradient(135deg,#db2777,#f472b6)"><i class="bi bi-boxes"></i></div>
                <div>
                    <h6>Inventory Value</h6>
                    <h3>@totalValue.ToString("N0") <small>EGP</small></h3>
                    <small>@totalStock units in stock</small>
                </div>
            </div>
        </div>

    </div>

    <!-- ============ Business row ============ -->
    <div class="row g-3 mt-1">

        <div class="col-md-6 col-xl-3">
            <a asp-controller="Customer" asp-action="Index" class="text-decoration-none">
                <div class="stat-mini">
                    <div class="ico" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-people-fill"></i></div>
                    <div><small>Customers</small><strong class="text-body">@totalCustomers</strong></div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-xl-3">
            <a asp-controller="Supplier" asp-action="Index" class="text-decoration-none">
                <div class="stat-mini">
                    <div class="ico" style="background:linear-gradient(135deg,#0891b2,#22d3ee)"><i class="bi bi-truck"></i></div>
                    <div><small>Suppliers</small><strong class="text-body">@totalSuppliers</strong></div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-xl-3">
            <a asp-controller="Expense" asp-action="Index" class="text-decoration-none">
                <div class="stat-mini">
                    <div class="ico" style="background:linear-gradient(135deg,#e11d48,#fb7185)"><i class="bi bi-wallet2"></i></div>
                    <div><small>Expenses (30 days)</small><strong class="text-body">@expenses30.ToString("N0") EGP</strong></div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-xl-3">
            <a asp-controller="Report" asp-action="Index" class="text-decoration-none">
                <div class="stat-mini">
                    <div class="ico" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="bi bi-graph-up-arrow"></i></div>
                    <div><small>Net cash flow (30 days)</small><strong class="@(cashFlow30 >= 0 ? "text-success" : "text-danger")">@cashFlow30.ToString("N0") EGP</strong></div>
                </div>
            </a>
        </div>

    </div>

    <!-- ============ Charts ============ -->
    <div class="row g-4 mt-1">

        <div class="col-lg-8">
            <div class="content-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-graph-up-arrow text-success me-2"></i>Sales - last 7 days
                    </h5>
                    <a asp-controller="Report" asp-action="Index" class="btn btn-sm btn-outline-primary">Full report</a>
                </div>
                <div class="chart-wrapper">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="content-card h-100">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>Stock by category
                </h5>
                <div class="chart-wrapper">
                    <canvas id="stockChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- ============ Lists ============ -->
    <div class="row g-4 mt-1">

        <div class="col-lg-4">
            <div class="content-card h-100">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-trophy-fill text-warning me-2"></i>Top selling
                </h5>

                @if (topProducts.Any())
                {
                    int rank = 1;
                    foreach (var top in topProducts)
                    {
                        <div class="list-row">
                            <div class="d-flex align-items-center gap-2">
                                <span class="rank-badge">@(rank++)</span>
                                <span class="fw-semibold">@top.Title</span>
                            </div>
                            <span class="pill green">@top.Quantity sold</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">
                        <i class="bi bi-bag fs-3 d-block mb-2"></i>No sales yet
                    </p>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="content-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-receipt text-primary me-2"></i>Recent sales
                    </h5>
                    <a asp-controller="Sale" asp-action="Index" class="small">View all</a>
                </div>

                @if (recentSales.Any())
                {
                    foreach (var sale in recentSales)
                    {
                        <div class="list-row">
                            <div>
                                <div class="fw-semibold">@(sale.Product?.Title ?? "Deleted product")</div>
                                <small class="text-muted">@sale.Quantity x @sale.UnitPrice.ToString("N0") &middot; @sale.SaleDate.ToString("dd MMM")</small>
                            </div>
                            <strong class="text-success">@sale.Total.ToString("N0")</strong>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">No sales yet</p>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="content-card h-100">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Low stock alerts
                </h5>

                @if (lowStock.Any())
                {
                    foreach (var product in lowStock)
                    {
                        <div class="list-row">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@Url.Content(product.ImagePath)" class="mini-thumb" alt="" />
                                }
                                <span class="fw-semibold">@product.Title</span>
                            </div>
                            <span class="pill @(product.Quantity == 0 ? "red" : "amber")">@(product.Quantity == 0 ? "Out" : product.Quantity + " left")</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">
                        <i class="bi bi-check-circle fs-3 d-block mb-2 text-success"></i>All products are well stocked
                    </p>
                }
            </div>
        </div>

    </div>

    <!-- ============ Latest products + AI ============ -->
    <div class="row g-4 mt-1 mb-2">

        <div class="col-lg-8">
            <div class="content-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-box-seam text-primary me-2"></i>Latest products
                    </h5>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in lastProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(product.ImagePath))
                                            {
                                                <img src="@Url.Content(product.ImagePath)" class="mini-thumb" alt="" />
                                            }
                                            <span class="fw-semibold">@product.Title</span>
                                        </div>
                                    </td>
                                    <td>@product.Price.ToString("N0") EGP</td>
                                    <td>@product.Quantity</td>
                                    <td class="text-end">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="content-card h-100">
                <div class="d-flex align-items-center">
                    <div class="ai-icon"><i class="bi bi-cpu-fill"></i></div>
                    <div class="ms-3">
                        <h5 class="fw-bold mb-1">AI Assistant</h5>
                        <small class="text-muted">Smart inventory analytics</small>
                    </div>
                </div>
                <hr />
                <p class="text-muted">Ask about products, categories, stock levels, inventory value and more.</p>
                <a asp-controller="AI" asp-action="Index" class="btn btn-primary w-100">
                    <i class="bi bi-stars me-2"></i>Open AI Assistant
                </a>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var salesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SalesLast7Days));
            var stockData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StockByCategory));

            function css(name) {
                return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
            }

            function applyTheme() {
                Chart.defaults.color = css("--muted");
                Chart.defaults.borderColor = css("--border");
            }
            applyTheme();

            var salesChart = new Chart(document.getElementById("salesChart"), {
                type: "line",
                data: {
                    labels: salesData.map(function (x) { return x.Label || x.label; }),
                    datasets: [{
                        label: "Revenue (EGP)",
                        data: salesData.map(function (x) { return x.Total !== undefined ? x.Total : x.total; }),
                        borderColor: "#6366f1",
                        backgroundColor: "rgba(99,102,241,0.15)",
                        fill: true,
                        tension: 0.38,
                        pointRadius: 4,
                        pointBackgroundColor: "#6366f1"
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            var palette = ["#6366f1", "#22c55e", "#f59e0b", "#ec4899", "#06b6d4", "#ef4444", "#a855f7", "#84cc16", "#f97316", "#14b8a6"];
            var stockChart = null;

            if (stockData && stockData.length) {
                stockChart = new Chart(document.getElementById("stockChart"), {
                    type: "doughnut",
                    data: {
                        labels: stockData.map(function (x) { return x.CategoryName || x.categoryName; }),
                        datasets: [{
                            data: stockData.map(function (x) { return x.TotalStock !== undefined ? x.TotalStock : x.totalStock; }),
                            backgroundColor: palette,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "62%",
                        plugins: { legend: { display: false } }
                    }
                });
            }

            document.addEventListener("themechange", function () {
                applyTheme();
                [salesChart, stockChart].forEach(function (c) {
                    if (!c) return;
                    if (c.options.scales) {
                        Object.keys(c.options.scales).forEach(function (k) {
                            c.options.scales[k].grid = { color: css("--border") };
                            c.options.scales[k].ticks = { color: css("--muted") };
                        });
                    }
                    c.update();
                });
            });
        });
    </script>
}
