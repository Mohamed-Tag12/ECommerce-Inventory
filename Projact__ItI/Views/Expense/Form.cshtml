@model Expense

@{
    ViewData["Title"] = (string)ViewBag.Heading;
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="page-wrapper">
    <div class="content-container" style="max-width:820px">

        <div class="d-flex align-items-center mb-4">
            <div class="title-icon"><i class="bi bi-wallet2"></i></div>
            <div>
                <h1 class="page-title">@ViewBag.Heading</h1>
                <p class="page-subtitle mb-0">Record what you spend to run the business</p>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header"><h5 class="fw-bold mb-0">Expense details</h5></div>
            <div class="p-4">
                <form method="post">
                    <input type="hidden" asp-for="ExpenseId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Shop rent" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Category" class="form-label">Category</label>
                            <select asp-for="Category" class="form-select">
                                @foreach (var c in Projact__ItI.Models.ExpenseCategories.All)
                                {
                                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Amount" class="form-label">Amount (EGP)</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ExpenseDate" class="form-label">Date</label>
                            <input asp-for="ExpenseDate" type="date" value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" class="form-control" />
                            <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Note" class="form-label">Note (optional)</label>
                        <textarea asp-for="Note" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Cancel</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
