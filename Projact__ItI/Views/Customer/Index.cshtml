@model List<Projact__ItI.ViewModels.CustomerRowViewModel>

@{
    ViewData["Title"] = "Customers";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid">

    <partial name="_Alerts" />

    <div class="page-head">
        <div>
            <h2><i class="bi bi-people-fill text-primary me-2"></i>Customers</h2>
            <p class="text-muted mb-0">Know who buys from you and how much they spend</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="tool-search">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search customers..." />
            </form>
            <a asp-action="Add" class="btn btn-primary px-4">
                <i class="bi bi-person-plus me-2"></i>Add Customer
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-people"></i></div>
                <div><small>Customers</small><strong>@ViewBag.TotalCustomers</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="bi bi-cash-coin"></i></div>
                <div><small>Total spent</small><strong>@(((decimal)ViewBag.TotalSpent).ToString("N0")) EGP</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-graph-up"></i></div>
                <div><small>Average per customer</small><strong>@(((decimal)ViewBag.Average).ToString("N0")) EGP</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#db2777,#f472b6)"><i class="bi bi-person-plus"></i></div>
                <div><small>New this month</small><strong>@ViewBag.NewThisMonth</strong></div>
            </div>
        </div>
    </div>

    <div class="app-card overflow-hidden">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>City</th>
                            <th class="text-center">Orders</th>
                            <th>Total spent</th>
                            <th>Last purchase</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-circle">@row.Customer.Name.Substring(0, 1).ToUpper()</div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@row.Customer.CustomerId" class="fw-bold text-decoration-none">@row.Customer.Name</a>
                                            <div class="small text-muted">Since @row.Customer.JoinedAt.ToString("MMM yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@row.Customer.Email</div>
                                    <div class="small text-muted">@row.Customer.Phone</div>
                                </td>
                                <td>@row.Customer.City</td>
                                <td class="text-center"><span class="pill blue">@row.Orders</span></td>
                                <td class="fw-bold text-success">@row.TotalSpent.ToString("N0") EGP</td>
                                <td class="text-muted">@(row.LastPurchase.HasValue ? row.LastPurchase.Value.ToString("dd MMM yyyy") : "-")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@row.Customer.CustomerId" class="btn btn-sm btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@row.Customer.CustomerId" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Delete" asp-route-id="@row.Customer.CustomerId" method="post"
                                              onsubmit="return confirm('Delete this customer? Their past sales are kept.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-1 text-secondary"></i>
                <h4 class="mt-3">No customers found</h4>
                <a asp-action="Add" class="btn btn-primary mt-2"><i class="bi bi-person-plus me-2"></i>Add Customer</a>
            </div>
        }
    </div>

</div>
