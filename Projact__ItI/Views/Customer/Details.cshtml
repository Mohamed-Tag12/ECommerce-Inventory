@model Projact__ItI.ViewModels.CustomerDetailsViewModel

@{
    ViewData["Title"] = "Customer";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var c = Model.Customer;
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2><i class="bi bi-person-badge-fill text-primary me-2"></i>Customer profile</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-primary"><i class="bi bi-pencil me-2"></i>Edit</a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="app-card p-4 text-center h-100">
                <div class="avatar-circle lg mx-auto">@c.Name.Substring(0, 1).ToUpper()</div>
                <h4 class="fw-bold mt-3 mb-1">@c.Name</h4>
                <p class="text-muted">Customer since @c.JoinedAt.ToString("dd MMM yyyy")</p>

                <div class="text-start mt-4">
                    <div class="info-line"><i class="bi bi-envelope"></i>@(string.IsNullOrWhiteSpace(c.Email) ? "-" : c.Email)</div>
                    <div class="info-line"><i class="bi bi-telephone"></i>@(string.IsNullOrWhiteSpace(c.Phone) ? "-" : c.Phone)</div>
                    <div class="info-line"><i class="bi bi-geo-alt"></i>@(string.IsNullOrWhiteSpace(c.City) ? "-" : c.City)</div>
                </div>

                <hr />

                <div class="row text-center">
                    <div class="col-4"><div class="fw-bold fs-4">@Model.Sales.Count</div><small class="text-muted">Orders</small></div>
                    <div class="col-4"><div class="fw-bold fs-4 text-success">@Model.TotalSpent.ToString("N0")</div><small class="text-muted">Spent</small></div>
                    <div class="col-4"><div class="fw-bold fs-4">@Model.AverageOrder.ToString("N0")</div><small class="text-muted">Average</small></div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="app-card overflow-hidden h-100">
                <div class="p-4 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-receipt text-primary me-2"></i>Purchase history</h5>
                    <a asp-controller="Sale" asp-action="Add" class="btn btn-sm btn-success"><i class="bi bi-cart-plus me-1"></i>New Sale</a>
                </div>

                @if (Model.Sales.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Product</th><th>Qty</th><th>Total</th><th>Date</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Sales)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(s.Product?.ImagePath))
                                                {
                                                    <img src="@Url.Content(s.Product.ImagePath)" class="mini-thumb" alt="" />
                                                }
                                                <span class="fw-semibold">@(s.Product?.Title ?? "Deleted product")</span>
                                            </div>
                                        </td>
                                        <td>@s.Quantity</td>
                                        <td class="fw-bold text-success">@s.Total.ToString("N0") EGP</td>
                                        <td class="text-muted">@s.SaleDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            <a asp-controller="Sale" asp-action="Invoice" asp-route-id="@s.SaleId" class="btn btn-sm btn-outline-primary"><i class="bi bi-printer"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-5 mb-0">No purchases yet</p>
                }
            </div>
        </div>

    </div>

</div>
