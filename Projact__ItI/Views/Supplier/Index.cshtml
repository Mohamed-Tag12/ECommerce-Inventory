@model List<Projact__ItI.ViewModels.SupplierRowViewModel>

@{
    ViewData["Title"] = "Suppliers";
    Layout = "~/Views/Shared/AdminLayout.cshtml";

    var palette = new[]
    {
        ("#2563eb", "#60a5fa"), ("#7c3aed", "#a78bfa"), ("#16a34a", "#4ade80"), ("#ea580c", "#fb923c"),
        ("#db2777", "#f472b6"), ("#0891b2", "#22d3ee"), ("#ca8a04", "#facc15")
    };
}

<div class="container-fluid">

    <partial name="_Alerts" />

    <div class="page-head">
        <div>
            <h2><i class="bi bi-truck text-primary me-2"></i>Suppliers</h2>
            <p class="text-muted mb-0">The companies that keep your shelves full</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="tool-search">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search suppliers..." />
            </form>
            <a asp-controller="Purchase" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-in-down me-2"></i>Restock history
            </a>
            <a asp-action="Add" class="btn btn-primary px-4">
                <i class="bi bi-plus-circle me-2"></i>Add Supplier
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-truck"></i></div>
                <div><small>Suppliers</small><strong>@ViewBag.TotalSuppliers</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="bi bi-check2-circle"></i></div>
                <div><small>Active</small><strong>@ViewBag.ActiveSuppliers</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-boxes"></i></div>
                <div><small>Units received</small><strong>@ViewBag.TotalUnits</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#db2777,#f472b6)"><i class="bi bi-wallet2"></i></div>
                <div><small>Spent on stock</small><strong>@(((decimal)ViewBag.TotalSpent).ToString("N0")) EGP</strong></div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var row = Model[i];
                var s = row.Supplier;
                var colors = palette[i % palette.Length];

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="cat-card">

                        <div class="cat-top" style="background:linear-gradient(135deg,@colors.Item1,@colors.Item2)">
                            <div class="cat-icon"><i class="bi bi-building"></i></div>
                            <span class="cat-id">@(s.IsActive ? "Active" : "Inactive")</span>
                        </div>

                        <div class="cat-body">
                            <h5 class="cat-title">@s.Name</h5>

                            <div class="mb-2">
                                @if (!string.IsNullOrWhiteSpace(s.Supplies))
                                {
                                    foreach (var tag in s.Supplies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <span class="chip">@tag</span>
                                    }
                                }
                            </div>

                            <div class="info-line"><i class="bi bi-person"></i>@(s.ContactPerson ?? "-")</div>
                            <div class="info-line"><i class="bi bi-telephone"></i>@(s.Phone ?? "-")</div>
                            <div class="info-line"><i class="bi bi-envelope"></i>@(s.Email ?? "-")</div>
                            <div class="info-line"><i class="bi bi-geo-alt"></i>@(s.City ?? "-")</div>

                            <div class="cat-meta mt-3">
                                <span class="pill blue"><i class="bi bi-box-arrow-in-down"></i> @row.Purchases orders</span>
                                <span class="pill green">@row.TotalSpent.ToString("N0") EGP</span>
                            </div>
                        </div>

                        <div class="cat-actions">
                            <a asp-controller="Purchase" asp-action="Add" asp-route-supplierId="@s.SupplierId" class="cat-btn sell">
                                <i class="bi bi-box-arrow-in-down"></i> Restock
                            </a>
                            <a asp-action="Edit" asp-route-id="@s.SupplierId" class="cat-btn edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@s.SupplierId" method="post" class="d-flex"
                                  onsubmit="return confirm('Delete this supplier?');">
                                <button type="submit" class="cat-btn delete" style="width:46px"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="app-card text-center py-5">
            <i class="bi bi-truck display-1 text-secondary"></i>
            <h4 class="mt-3">No suppliers found</h4>
            <a asp-action="Add" class="btn btn-primary mt-2"><i class="bi bi-plus-circle me-2"></i>Add Supplier</a>
        </div>
    }

</div>
