@model Projact__ItI.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Reports";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>
                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>
                Sales Reports
            </h2>
            <p class="text-muted mb-0">@Model.From.ToString("dd MMM yyyy") - @Model.To.ToString("dd MMM yyyy")</p>
        </div>

        <a asp-action="Export" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
           class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet me-2"></i>
            Export CSV
        </a>
    </div>

    <form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-4">
        <div>
            <label class="form-label small mb-1">From</label>
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label class="form-label small mb-1">To</label>
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-2"></i>Apply</button>

        <div class="ms-md-3 d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" asp-action="Index"
               asp-route-from="@DateTime.Today.ToString("yyyy-MM-dd")" asp-route-to="@DateTime.Today.ToString("yyyy-MM-dd")">Today</a>
            <a class="btn btn-outline-secondary" asp-action="Index"
               asp-route-from="@DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd")" asp-route-to="@DateTime.Today.ToString("yyyy-MM-dd")">7 days</a>
            <a class="btn btn-outline-secondary" asp-action="Index"
               asp-route-from="@DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd")" asp-route-to="@DateTime.Today.ToString("yyyy-MM-dd")">30 days</a>
            <a class="btn btn-outline-secondary" asp-action="Index"
               asp-route-from="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" asp-route-to="@DateTime.Today.ToString("yyyy-MM-dd")">This month</a>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="bi bi-cash-coin"></i></div>
                <div><small>Revenue</small><strong>@Model.Revenue.ToString("N0") EGP</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-receipt"></i></div>
                <div><small>Orders</small><strong>@Model.Orders</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-bag-check"></i></div>
                <div><small>Items sold</small><strong>@Model.ItemsSold</strong></div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#db2777,#f472b6)"><i class="bi bi-calculator"></i></div>
                <div><small>Average order</small><strong>@Model.AverageOrder.ToString("N0") EGP</strong></div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="content-card h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-graph-up text-success me-2"></i>Revenue per day</h5>
                <div class="chart-wrapper" style="height:300px">
                    <canvas id="dailyChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="content-card h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Sales by category</h5>
                @if (Model.ByCategory.Any())
                {
                    <div class="chart-wrapper" style="height:300px">
                        <canvas id="categoryChart"></canvas>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-5 mb-0">No sales in this period</p>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card overflow-hidden">
                <div class="p-4 pb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Top products</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>#</th><th>Product</th><th>Qty</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody>
                            @{ int i = 1; }
                            @foreach (var p in Model.TopProducts)
                            {
                                <tr>
                                    <td><span class="rank-badge">@(i++)</span></td>
                                    <td class="fw-semibold">@p.Title</td>
                                    <td>@p.Quantity</td>
                                    <td class="text-end fw-bold text-success">@p.Revenue.ToString("N0") EGP</td>
                                </tr>
                            }
                            @if (!Model.TopProducts.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-4">No sales in this period</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card overflow-hidden">
                <div class="p-4 pb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-tags-fill text-primary me-2"></i>Category breakdown</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr><th>Category</th><th>Qty</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.ByCategory)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>@c.Quantity</td>
                                    <td class="text-end fw-bold">@c.Revenue.ToString("N0") EGP</td>
                                </tr>
                            }
                            @if (!Model.ByCategory.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">No sales in this period</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var daily = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Daily));
            var byCategory = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ByCategory));

            function css(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
            function applyTheme() { Chart.defaults.color = css("--muted"); Chart.defaults.borderColor = css("--border"); }
            applyTheme();

            var dailyChart = new Chart(document.getElementById("dailyChart"), {
                type: "bar",
                data: {
                    labels: daily.map(function (x) { return x.Label; }),
                    datasets: [{
                        label: "Revenue (EGP)",
                        data: daily.map(function (x) { return x.Total; }),
                        backgroundColor: "rgba(99,102,241,0.8)",
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            var palette = ["#6366f1", "#22c55e", "#f59e0b", "#ec4899", "#06b6d4", "#ef4444", "#a855f7", "#84cc16", "#f97316", "#14b8a6"];
            var catEl = document.getElementById("categoryChart");
            var categoryChart = null;

            if (catEl && byCategory.length) {
                categoryChart = new Chart(catEl, {
                    type: "doughnut",
                    data: {
                        labels: byCategory.map(function (x) { return x.Name; }),
                        datasets: [{ data: byCategory.map(function (x) { return x.Revenue; }), backgroundColor: palette, borderWidth: 0 }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: "58%",
                        plugins: { legend: { position: "bottom" } }
                    }
                });
            }

            document.addEventListener("themechange", function () {
                applyTheme();
                [dailyChart, categoryChart].forEach(function (c) {
                    if (!c) return;
                    if (c.options.scales) {
                        Object.keys(c.options.scales).forEach(function (k) {
                            c.options.scales[k].grid = { color: css("--border") };
                            c.options.scales[k].ticks = { color: css("--muted") };
                        });
                    }
                    c.update();
                });
            });
        });
    </script>
}
