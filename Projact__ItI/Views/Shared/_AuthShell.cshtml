@{
    var mode = (ViewData["Mode"] as string) ?? "login";

    var errors = ViewContext.ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct()
        .ToList();

    var email = ViewData["Email"] as string ?? "";
    var firstName = ViewData["FirstName"] as string ?? "";
    var lastName = ViewData["LastName"] as string ?? "";
}

<div class="scene" aria-hidden="true">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>
    <div class="grid"></div>
</div>

<div class="theme-fab" onclick="toggleTheme()" title="Light / Dark">
    <i class="bi bi-moon-stars-fill"></i>
    <i class="bi bi-sun-fill"></i>
</div>

<main class="stage">

    <div class="shell @(mode == "register" ? "is-register" : "")" id="shell"
         data-login-url="@Url.Action("Login", "User")" data-register-url="@Url.Action("Register", "User")">

        <!-- ================= Sign in ================= -->
        <section class="panel panel-login">
            <div class="panel-inner">

                <div class="brand rise" style="--i:0"><i class="bi bi-cart3"></i>E-Commerce</div>

                <div class="rise" style="--i:1"><h2 class="auth-title">Welcome back</h2></div>

                <p class="sub rise" style="--i:2">
                    Manage your
                    <span class="rot"><span class="rot-in">
                        <b>inventory</b><b>sales</b><b>customers</b><b>profit</b><b>inventory</b>
                    </span></span>
                </p>

                @if (mode == "login" && errors.Any())
                {
                    <div class="form-error">
                        @foreach (var er in errors)
                        {
                            <div><i class="bi bi-exclamation-circle me-1"></i>@er</div>
                        }
                    </div>
                }

                <form method="post" action="@Url.Action("Login", "User")">
                    @Html.AntiForgeryToken()

                    <div class="field rise" style="--i:3">
                        <label for="login_email">Email</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope lead-ico"></i>
                            <input type="email" id="login_email" name="Email" value="@(mode == "login" ? email : "")" placeholder="you@example.com" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="field rise" style="--i:4">
                        <label for="login_password">Password</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock lead-ico"></i>
                            <input type="password" id="login_password" name="Password" placeholder="Enter your password" autocomplete="current-password" required />
                            <i class="bi bi-eye toggle-pass" data-target="login_password"></i>
                        </div>
                    </div>

                    <div class="rise" style="--i:5">
                        <button type="submit" class="btn-auth">
                            <span class="go">Sign in <i class="bi bi-arrow-right ms-2"></i></span>
                            <i class="bi bi-arrow-repeat spin"></i>
                        </button>
                    </div>
                </form>

                <div class="m-switch">New here? <a href="#" data-switch="register">Create an account</a></div>

            </div>
        </section>

        <!-- ================= Register ================= -->
        <section class="panel panel-register">
            <div class="panel-inner">

                <div class="brand rise" style="--i:0"><i class="bi bi-cart3"></i>E-Commerce</div>

                <div class="rise" style="--i:1"><h2 class="auth-title">Create account</h2></div>

                <p class="sub rise" style="--i:2">It takes less than a minute</p>

                @if (mode == "register" && errors.Any())
                {
                    <div class="form-error">
                        @foreach (var er in errors)
                        {
                            <div><i class="bi bi-exclamation-circle me-1"></i>@er</div>
                        }
                    </div>
                }

                <form method="post" action="@Url.Action("Register", "User")" id="registerForm">
                    @Html.AntiForgeryToken()

                    <div class="row g-2">
                        <div class="col-6">
                            <div class="field rise" style="--i:3">
                                <label for="reg_first">First name</label>
                                <div class="input-wrap">
                                    <i class="bi bi-person lead-ico"></i>
                                    <input type="text" id="reg_first" name="FirstName" value="@(mode == "register" ? firstName : "")" placeholder="First" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="field rise" style="--i:3">
                                <label for="reg_last">Last name</label>
                                <div class="input-wrap">
                                    <i class="bi bi-person lead-ico"></i>
                                    <input type="text" id="reg_last" name="LastName" value="@(mode == "register" ? lastName : "")" placeholder="Last" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="field rise" style="--i:4">
                        <label for="reg_email">Email</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope lead-ico"></i>
                            <input type="email" id="reg_email" name="Email" value="@(mode == "register" ? email : "")" placeholder="you@example.com" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="field rise" style="--i:5">
                        <label for="reg_password">Password</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock lead-ico"></i>
                            <input type="password" id="reg_password" name="Password" placeholder="Create a password" autocomplete="new-password" required />
                            <i class="bi bi-eye toggle-pass" data-target="reg_password"></i>
                        </div>
                    </div>

                    <div class="field rise" style="--i:6">
                        <label for="reg_confirm">Confirm password</label>
                        <div class="input-wrap">
                            <i class="bi bi-shield-lock lead-ico"></i>
                            <input type="password" id="reg_confirm" name="ConfirmPassword" placeholder="Repeat the password" autocomplete="new-password" required />
                        </div>
                    </div>

                    <div class="rise" style="--i:7">
                        <button type="submit" class="btn-auth">
                            <span class="go">Create account <i class="bi bi-arrow-right ms-2"></i></span>
                            <i class="bi bi-arrow-repeat spin"></i>
                        </button>
                    </div>
                </form>

                <div class="m-switch">Already have an account? <a href="#" data-switch="login">Sign in</a></div>

            </div>
        </section>

        <!-- ================= Sliding overlay ================= -->
        <div class="overlay-wrap">
            <div class="overlay">

                <div class="ov ov-left">
                    <span class="bubble x1"></span><span class="bubble x2"></span><span class="bubble x3"></span>
                    <div class="stack">
                        <div class="sc"><img src="~/images/Electronics/15.jpeg" alt="" /></div>
                        <div class="sc"><img src="~/images/Coffee/1.jpeg" alt="" /></div>
                        <div class="sc"><img src="~/images/Tennis Racket/3.jpeg" alt="" /></div>
                    </div>
                    <h2>Already with us?</h2>
                    <p>Sign in to see today's sales, stock levels and your latest numbers.</p>
                    <button type="button" class="btn-ghost" data-switch="login"><i class="bi bi-arrow-left me-2"></i>Sign in</button>
                </div>

                <div class="ov ov-right">
                    <span class="bubble x1"></span><span class="bubble x2"></span><span class="bubble x3"></span>
                    <div class="stack">
                        <div class="sc"><img src="~/images/Electronics/3.jpeg" alt="" /></div>
                        <div class="sc"><img src="~/images/Electronics/2.jpeg" alt="" /></div>
                        <div class="sc"><img src="~/images/Electronics/5.jpeg" alt="" /></div>
                    </div>
                    <h2>New here?</h2>
                    <p>Create an account and start managing your store in minutes.</p>
                    <button type="button" class="btn-ghost" data-switch="register">Create account<i class="bi bi-arrow-right ms-2"></i></button>
                </div>

            </div>
        </div>

    </div>

</main>

<script>
    (function () {
        var shell = document.getElementById('shell');

        function setMode(mode) {
            shell.classList.toggle('is-register', mode === 'register');
            document.title = (mode === 'register' ? 'Register' : 'Login') + ' - E-Commerce';

            var url = mode === 'register' ? shell.getAttribute('data-register-url') : shell.getAttribute('data-login-url');
            if (window.history && history.replaceState) history.replaceState(null, '', url);

            if (!window.matchMedia('(hover: none)').matches) {
                setTimeout(function () {
                    var el = shell.querySelector(mode === 'register' ? '.panel-register input' : '.panel-login input');
                    if (el) el.focus({ preventScroll: true });
                }, 600);
            }
        }

        document.querySelectorAll('[data-switch]').forEach(function (b) {
            b.addEventListener('click', function (e) {
                e.preventDefault();
                setMode(b.getAttribute('data-switch'));
            });
        });

        // show / hide password
        document.querySelectorAll('.toggle-pass').forEach(function (icon) {
            icon.addEventListener('click', function () {
                var input = document.getElementById(icon.getAttribute('data-target'));
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = (show ? 'bi bi-eye-slash' : 'bi bi-eye') + ' toggle-pass';
            });
        });

        // confirm password must match
        var reg = document.getElementById('registerForm');
        var pass = document.getElementById('reg_password');
        var conf = document.getElementById('reg_confirm');
        function check() { conf.setCustomValidity(conf.value && conf.value !== pass.value ? 'Passwords do not match' : ''); }
        pass.addEventListener('input', check);
        conf.addEventListener('input', check);

        // loading state on submit
        document.querySelectorAll('.shell form').forEach(function (f) {
            f.addEventListener('submit', function () {
                if (!f.checkValidity()) return;
                var b = f.querySelector('.btn-auth');
                if (b) b.classList.add('loading');
            });
        });
    })();
</script>
