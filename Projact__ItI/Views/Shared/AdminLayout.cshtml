@using Microsoft.AspNetCore.Http
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var userName = Context.Session.GetString("UserName") ?? "Admin";
    var initial = string.IsNullOrWhiteSpace(userName) ? "A" : userName.Trim().Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce</title>

    <partial name="_ThemeInit" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>

    <aside class="sidebar">

        <a class="logo" asp-controller="Home" asp-action="Index">
            <i class="bi bi-cart3"></i>
            <h3>E-Commerce</h3>
        </a>

        <nav class="menu">

            <div class="menu-label">Overview</div>

            <a asp-controller="Home" asp-action="Index" class="@(controller == "Home" ? "active" : "")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            <a asp-controller="Report" asp-action="Index" class="@(controller == "Report" ? "active" : "")">
                <i class="bi bi-bar-chart-line"></i><span>Reports</span>
            </a>

            <div class="menu-label">Inventory</div>

            <a asp-controller="Product" asp-action="Index" class="@(controller == "Product" ? "active" : "")">
                <i class="bi bi-box-seam"></i><span>Products</span>
            </a>

            <a asp-controller="Category" asp-action="Index" class="@(controller == "Category" ? "active" : "")">
                <i class="bi bi-tags"></i><span>Categories</span>
            </a>

            <a asp-controller="Purchase" asp-action="Index" class="@(controller == "Purchase" ? "active" : "")">
                <i class="bi bi-box-arrow-in-down"></i><span>Restock</span>
            </a>

            <div class="menu-label">Sales</div>

            <a asp-controller="Sale" asp-action="Index" class="@(controller == "Sale" ? "active" : "")">
                <i class="bi bi-receipt"></i><span>Sales</span>
            </a>

            <a asp-controller="Customer" asp-action="Index" class="@(controller == "Customer" ? "active" : "")">
                <i class="bi bi-people"></i><span>Customers</span>
            </a>

            <div class="menu-label">Business</div>

            <a asp-controller="Supplier" asp-action="Index" class="@(controller == "Supplier" ? "active" : "")">
                <i class="bi bi-truck"></i><span>Suppliers</span>
            </a>

            <a asp-controller="Expense" asp-action="Index" class="@(controller == "Expense" ? "active" : "")">
                <i class="bi bi-wallet2"></i><span>Expenses</span>
            </a>

            <div class="menu-label">Tools</div>

            <a asp-controller="AI" asp-action="Index" class="@(controller == "AI" ? "active" : "")">
                <i class="bi bi-cpu-fill"></i><span>AI Assistant</span>
                <span class="ai-badge">AI</span>
            </a>

        </nav>

        <div class="sidebar-footer">
            <a asp-controller="User" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i><span>Logout</span>
            </a>
        </div>

    </aside>

    <div class="main-content">

        <header class="topbar">

            <div>
                <h2>@ViewData["Title"]</h2>
            </div>

            <form class="top-search" asp-controller="Product" asp-action="Index" method="get">
                <i class="bi bi-search"></i>
                <input type="text" name="search" placeholder="Search products..." autocomplete="off" />
            </form>

            <div class="top-actions">
                <a class="btn btn-success" asp-controller="Sale" asp-action="Add"><i class="bi bi-cart-plus me-1"></i><span>New Sale</span></a>
                <a class="btn btn-primary" asp-controller="Product" asp-action="Add"><i class="bi bi-plus-lg me-1"></i><span>Add Product</span></a>
            </div>

            <div class="topbar-right">

                <div class="icon-btn theme-toggle" onclick="toggleTheme()" title="Light / Dark mode">
                    <i class="bi bi-moon-stars-fill"></i>
                    <i class="bi bi-sun-fill"></i>
                </div>

                @await Component.InvokeAsync("LowStock")

                <div class="dropdown">
                    <div class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar">@initial</div>
                        <span>@userName</span>
                        <i class="bi bi-chevron-down small text-muted"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Sale" asp-action="Add"><i class="bi bi-cart-plus me-2"></i>New Sale</a></li>
                        <li><a class="dropdown-item" asp-controller="Product" asp-action="Add"><i class="bi bi-plus-circle me-2"></i>Add Product</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" asp-controller="User" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </div>

            </div>

        </header>

        <main class="page-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
