@model List<Category>

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/AdminLayout.cshtml";

    // gradient palette (cycled per card)
    var palette = new[]
    {
        ("#2563eb", "#60a5fa"),
        ("#7c3aed", "#a78bfa"),
        ("#16a34a", "#4ade80"),
        ("#ea580c", "#fb923c"),
        ("#db2777", "#f472b6"),
        ("#0891b2", "#22d3ee"),
        ("#ca8a04", "#facc15"),
        ("#dc2626", "#f87171")
    };

    // pick an icon from the category name
    Func<string, string> iconFor = name =>
    {
        var n = (name ?? "").ToLower();
        if (n.Contains("phone") || n.Contains("mobile")) return "bi-phone";
        if (n.Contains("evening")) return "bi-gem";
        if (n.Contains("electr")) return "bi-laptop";
        if (n.Contains("book")) return "bi-book";
        if (n.Contains("cloth") || n.Contains("dress") || n.Contains("fashion")) return "bi-handbag";
        if (n.Contains("home") || n.Contains("appliance")) return "bi-house-gear";
        if (n.Contains("sport")) return "bi-trophy";
        if (n.Contains("toy") || n.Contains("game") || n.Contains("puzzle")) return "bi-controller";
        if (n.Contains("beauty") || n.Contains("care")) return "bi-stars";
        if (n.Contains("auto") || n.Contains("car")) return "bi-car-front";
        if (n.Contains("health") || n.Contains("well")) return "bi-heart-pulse";
        if (n.Contains("food") || n.Contains("bever") || n.Contains("coffee")) return "bi-cup-hot";
        return "bi-tag";
    };

    var totalProducts = Model.Sum(c => c.Products?.Count ?? 0);
    var emptyCount = Model.Count(c => (c.Products?.Count ?? 0) == 0);
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>
                <i class="bi bi-tags-fill text-primary me-2"></i>
                Categories
            </h2>
            <p class="text-muted mb-0">Organize your store into clear, easy-to-browse groups</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="tool-search">
                <i class="bi bi-search"></i>
                <input type="text" id="catSearch" placeholder="Search categories..." />
            </div>
            <a asp-action="Add" class="btn btn-primary px-4 rounded-3">
                <i class="bi bi-plus-circle me-2"></i>
                Add Category
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#2563eb,#60a5fa)"><i class="bi bi-tags"></i></div>
                <div><small>Categories</small><strong>@Model.Count</strong></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#16a34a,#4ade80)"><i class="bi bi-box-seam"></i></div>
                <div><small>Total Products</small><strong>@totalProducts</strong></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-inbox"></i></div>
                <div><small>Empty Categories</small><strong>@emptyCount</strong></div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4" id="catGrid">

            @for (int i = 0; i < Model.Count; i++)
            {
                var category = Model[i];
                var colors = palette[i % palette.Length];
                var count = category.Products?.Count ?? 0;
                var preview = category.Products?
                    .Where(p => !string.IsNullOrEmpty(p.ImagePath))
                    .Take(3)
                    .ToList() ?? new List<Product>();

                <div class="col-12 col-md-6 col-xl-4 cat-item" data-name="@category.Name.ToLower()">

                    <div class="cat-card">

                        <div class="cat-top" style="background:linear-gradient(135deg,@colors.Item1,@colors.Item2)">
                            <div class="cat-icon">
                                <i class="bi @iconFor(category.Name)"></i>
                            </div>
                            <span class="cat-id">#@category.CategoryId</span>
                        </div>

                        <div class="cat-body">

                            <h5 class="cat-title">@category.Name</h5>

                            <p class="cat-desc">
                                @(string.IsNullOrWhiteSpace(category.Description) ? "No description" : category.Description)
                            </p>

                            <div class="cat-meta">

                                <span class="pill @(count == 0 ? "amber" : "green")">
                                    <i class="bi bi-box-seam me-1"></i>
                                    @count @(count == 1 ? "product" : "products")
                                </span>

                                @if (preview.Any())
                                {
                                    <div class="cat-thumbs">
                                        @foreach (var p in preview)
                                        {
                                            <img src="@Url.Content(p.ImagePath!)" alt="@p.Title" title="@p.Title" />
                                        }
                                    </div>
                                }

                            </div>

                        </div>

                        <div class="cat-actions">

                            <a asp-action="Details" asp-route-id="@category.CategoryId" class="cat-btn view">
                                <i class="bi bi-eye"></i> View
                            </a>

                            <a asp-action="Edit" asp-route-id="@category.CategoryId" class="cat-btn edit">
                                <i class="bi bi-pencil"></i> Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@category.CategoryId" class="cat-btn delete">
                                <i class="bi bi-trash"></i>
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

        <div id="noResults" class="text-center py-5 d-none">
            <i class="bi bi-search display-3 text-secondary"></i>
            <h5 class="mt-3">No matching categories</h5>
        </div>
    }
    else
    {
        <div class="app-card text-center py-5">

            <i class="bi bi-tags display-1 text-secondary"></i>

            <h4 class="mt-3">No Categories Found</h4>

            <p class="text-muted">Add your first category.</p>

            <a asp-action="Add" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>
                Add Category
            </a>

        </div>
    }

</div>
@section Scripts {
    <script>
        (function () {
            var input = document.getElementById("catSearch");
            if (!input) return;

            input.addEventListener("input", function () {
                var term = input.value.trim().toLowerCase();
                var visible = 0;

                document.querySelectorAll(".cat-item").forEach(function (el) {
                    var match = el.getAttribute("data-name").indexOf(term) !== -1;
                    el.style.display = match ? "" : "none";
                    if (match) visible++;
                });

                document.getElementById("noResults").classList.toggle("d-none", visible !== 0);
            });
        })();
    </script>
}
