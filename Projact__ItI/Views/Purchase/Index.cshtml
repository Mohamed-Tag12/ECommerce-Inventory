@model List<Purchase>

@{
    ViewData["Title"] = "Restock";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid">

    <partial name="_Alerts" />

    <div class="page-head">
        <div>
            <h2><i class="bi bi-box-arrow-in-down text-primary me-2"></i>Restock history</h2>
            <p class="text-muted mb-0">Every delivery from your suppliers. New deliveries increase stock automatically.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="tool-search">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search product or supplier..." />
            </form>
            <a asp-action="Add" class="btn btn-primary px-4">
                <i class="bi bi-plus-circle me-2"></i>New Restock
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#db2777,#f472b6)"><i class="bi bi-wallet2"></i></div>
                <div><small>Total spent on stock</small><strong>@(((decimal)ViewBag.TotalSpent).ToString("N0")) EGP</strong></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#4f46e5,#818cf8)"><i class="bi bi-receipt"></i></div>
                <div><small>Deliveries</small><strong>@ViewBag.Count</strong></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-boxes"></i></div>
                <div><small>Units received</small><strong>@ViewBag.TotalUnits</strong></div>
            </div>
        </div>
    </div>

    <div class="app-card overflow-hidden">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Supplier</th>
                            <th>Qty</th>
                            <th>Unit cost</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@p.PurchaseId</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(p.Product?.ImagePath))
                                        {
                                            <img src="@Url.Content(p.Product.ImagePath)" class="mini-thumb" alt="" />
                                        }
                                        <span class="fw-semibold">@p.Product?.Title</span>
                                    </div>
                                </td>
                                <td>@p.Supplier?.Name</td>
                                <td><span class="pill green">+@p.Quantity</span></td>
                                <td>@p.UnitCost.ToString("N0") EGP</td>
                                <td class="fw-bold">@p.Total.ToString("N0") EGP</td>
                                <td class="text-muted">@p.PurchaseDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@p.PurchaseId" method="post"
                                          onsubmit="return confirm('Cancel this restock and remove those units from stock?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel"><i class="bi bi-x-circle"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-box-arrow-in-down display-1 text-secondary"></i>
                <h4 class="mt-3">No restocks yet</h4>
                <a asp-action="Add" class="btn btn-primary mt-2"><i class="bi bi-plus-circle me-2"></i>New Restock</a>
            </div>
        }
    </div>

</div>
