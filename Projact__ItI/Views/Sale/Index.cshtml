@model List<Sale>

@{
    ViewData["Title"] = "Sales";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-head">
        <div>
            <h2>
                <i class="bi bi-receipt text-primary me-2"></i>
                Sales
            </h2>
            <p class="text-muted mb-0">Record and track every sale. Stock updates automatically.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <form method="get" class="d-flex">
                <div class="tool-search">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search product or customer..." />
                </div>
            </form>
            <a asp-action="Add" class="btn btn-primary px-4 rounded-3">
                <i class="bi bi-plus-circle me-2"></i>
                New Sale
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#16a34a,#22c55e)"><i class="bi bi-cash-coin"></i></div>
                <div><small>Total Revenue</small><strong>@(((decimal)ViewBag.TotalRevenue).ToString("N0")) EGP</strong></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#2563eb,#3b82f6)"><i class="bi bi-receipt-cutoff"></i></div>
                <div><small>Orders</small><strong>@ViewBag.SalesCount</strong></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="ico" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-bag-check"></i></div>
                <div><small>Items Sold</small><strong>@ViewBag.ItemsSold</strong></div>
            </div>
        </div>
    </div>

    <div class="app-card overflow-hidden">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0 sales-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Customer</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                            <th>Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@sale.SaleId</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(sale.Product?.ImagePath))
                                        {
                                            <img src="@Url.Content(sale.Product.ImagePath)" class="mini-thumb" alt="" />
                                        }
                                        <span class="fw-semibold">@(sale.Product?.Title ?? "Deleted product")</span>
                                    </div>
                                </td>
                                <td>@(sale.CustomerName ?? "Walk-in Customer")</td>
                                <td>@sale.Quantity</td>
                                <td>@sale.UnitPrice.ToString("N0") EGP</td>
                                <td class="fw-bold text-success">@sale.Total.ToString("N0") EGP</td>
                                <td class="text-muted">@sale.SaleDate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Invoice" asp-route-id="@sale.SaleId" class="btn btn-sm btn-outline-primary rounded-3" title="Print invoice">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@sale.SaleId" method="post"
                                          onsubmit="return confirm('Cancel this sale and return the items to stock?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Cancel sale">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt display-1 text-secondary"></i>
                <h4 class="mt-3">No sales yet</h4>
                <p class="text-muted">Record your first sale to see it here.</p>
                <a asp-action="Add" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>New Sale
                </a>
            </div>
        }

    </div>

</div>
