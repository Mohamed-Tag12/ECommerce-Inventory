@model Sale

@{
    ViewData["Title"] = "Invoice";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var invoiceNo = "INV-" + Model.SaleId.ToString("D5");
}

<div class="container-fluid">

    <div class="page-head no-print">
        <div>
            <h2><i class="bi bi-file-earmark-text text-primary me-2"></i>Invoice</h2>
            <p class="text-muted mb-0">@invoiceNo</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <button type="button" class="btn btn-primary" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>Print
            </button>
        </div>
    </div>

    <div class="app-card invoice mx-auto p-4 p-md-5" style="max-width:820px">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="title-icon mb-0"><i class="bi bi-cart3"></i></div>
                <div>
                    <h4 class="fw-bold mb-0">E-Commerce</h4>
                    <small class="text-muted">Inventory &amp; Sales System</small>
                </div>
            </div>
            <div class="text-md-end">
                <h3 class="fw-bold mb-1">INVOICE</h3>
                <div class="text-muted">No: <strong class="text-body">@invoiceNo</strong></div>
                <div class="text-muted">Date: <strong class="text-body">@Model.SaleDate.ToString("dd MMM yyyy, HH:mm")</strong></div>
            </div>
        </div>

        <hr />

        <div class="mb-4">
            <small class="text-muted text-uppercase fw-bold">Billed to</small>
            <div class="fs-5 fw-semibold">@(Model.CustomerName ?? "Walk-in Customer")</div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Category</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-semibold">@(Model.Product?.Title ?? "Deleted product")</td>
                        <td>@(Model.Product?.Category?.Name ?? "-")</td>
                        <td class="text-center">@Model.Quantity</td>
                        <td class="text-end">@Model.UnitPrice.ToString("N2") EGP</td>
                        <td class="text-end fw-bold">@Model.Total.ToString("N2") EGP</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <div style="min-width:260px">
                <div class="d-flex justify-content-between py-2 text-muted">
                    <span>Subtotal</span><span>@Model.Total.ToString("N2") EGP</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between py-2 fs-4 fw-bold">
                    <span>Total</span><span class="text-success">@Model.Total.ToString("N2") EGP</span>
                </div>
            </div>
        </div>

        <hr class="mt-4" />
        <p class="text-center text-muted mb-0">Thank you for your purchase!</p>

    </div>

</div>
