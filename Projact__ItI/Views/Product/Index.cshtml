@model List<Product>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/AdminLayout.cshtml";

    var categories = (List<Category>)ViewBag.Categories;
    int? selCategory = ViewBag.CategoryId;
    string selStock = ViewBag.Stock ?? "";
    string selSort = ViewBag.Sort ?? "";
}

<div class="container-fluid">

    <div class="page-head">
        <div>
            <h2>
                <i class="bi bi-box-seam-fill text-primary me-2"></i>
                Products
            </h2>
            <p class="text-muted mb-0">@Model.Count product(s) in your inventory</p>
        </div>

        <a asp-action="Add" class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-2"></i>
            Add Product
        </a>
    </div>

    <form method="get" class="d-flex flex-wrap gap-2 mb-4" id="filterForm">

        <div class="tool-search">
            <i class="bi bi-search"></i>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search products..." />
        </div>

        <select name="categoryId" class="tool-select" onchange="this.form.submit()">
            <option value="">All categories</option>
            @foreach (var c in categories)
            {
                <option value="@c.CategoryId" selected="@(selCategory == c.CategoryId)">@c.Name</option>
            }
        </select>

        <select name="stock" class="tool-select" onchange="this.form.submit()">
            <option value="" selected="@(selStock == "")">Any stock</option>
            <option value="in" selected="@(selStock == "in")">In stock</option>
            <option value="low" selected="@(selStock == "low")">Low stock</option>
            <option value="out" selected="@(selStock == "out")">Out of stock</option>
        </select>

        <select name="sort" class="tool-select" onchange="this.form.submit()">
            <option value="" selected="@(selSort == "")">Default order</option>
            <option value="newest" selected="@(selSort == "newest")">Newest first</option>
            <option value="name" selected="@(selSort == "name")">Name A-Z</option>
            <option value="price_asc" selected="@(selSort == "price_asc")">Price: low to high</option>
            <option value="price_desc" selected="@(selSort == "price_desc")">Price: high to low</option>
            <option value="stock" selected="@(selSort == "stock")">Lowest stock first</option>
        </select>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle me-1"></i> Reset
        </a>

    </form>

    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 col-xxl-3">

                    <div class="item-card">

                        <div class="item-img">
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@Url.Content(product.ImagePath)" alt="@product.Title" />
                            }
                            <span class="id-tag">#@product.ProductId</span>
                            <span class="cat-tag">@product.Category?.Name</span>
                        </div>

                        <div class="item-body">

                            <h5 class="item-title">@product.Title</h5>

                            <p class="item-desc">@(string.IsNullOrWhiteSpace(product.Description) ? "No description" : product.Description)</p>

                            <div class="cat-meta">

                                <div class="item-price">
                                    @product.Price.ToString("N0") <span>EGP</span>
                                </div>

                                @if (product.Quantity > 10)
                                {
                                    <span class="pill green"><i class="bi bi-check-circle-fill"></i> @product.Quantity in stock</span>
                                }
                                else if (product.Quantity > 0)
                                {
                                    <span class="pill amber"><i class="bi bi-exclamation-circle-fill"></i> @product.Quantity left</span>
                                }
                                else
                                {
                                    <span class="pill red"><i class="bi bi-x-circle-fill"></i> Out of stock</span>
                                }

                            </div>

                        </div>

                        <div class="item-actions">

                            @if (product.Quantity > 0)
                            {
                                <a asp-controller="Sale" asp-action="Add" asp-route-productId="@product.ProductId" class="cat-btn sell">
                                    <i class="bi bi-cart-plus"></i> Sell
                                </a>
                            }

                            <a asp-action="Details" asp-route-id="@product.ProductId" class="cat-btn view">
                                <i class="bi bi-eye"></i>
                            </a>

                            <a asp-action="Edit" asp-route-id="@product.ProductId" class="cat-btn edit">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a asp-action="Delete" asp-route-id="@product.ProductId" class="cat-btn delete">
                                <i class="bi bi-trash"></i>
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="app-card text-center py-5">
            <i class="bi bi-box-seam display-1 text-secondary"></i>
            <h4 class="mt-3">No products found</h4>
            <p class="text-muted">Try changing the filters or add a new product.</p>
            <a asp-action="Add" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Add Product
            </a>
        </div>
    }

</div>
